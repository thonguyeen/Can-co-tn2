// 2. TAB 1: TRANG CHỦ (FEED & STORIES)
// ==========================================
const FeedTab = () => {
  const [feedFilter, setFeedFilter] = useState('all');

  const filteredPosts = feedPosts.filter(post => {
    if (feedFilter === 'all') return true;
    return post.type === feedFilter;
  });

  return (
    <div className="h-full overflow-y-auto pb-28 md:pb-6 bg-[#F3F4F6]">
      <div className="md:hidden bg-white px-4 py-3 flex justify-between items-center sticky top-0 z-20 shadow-sm border-b border-gray-100">
        <h1 className="text-2xl font-black text-[#0068FF] tracking-tighter">Cần<span className="text-green-500">&</span>Có</h1>
        <div className="flex gap-3">
          <div className="bg-gray-100 p-2 rounded-full cursor-pointer"><Search size={20} className="text-gray-700"/></div>
          <div className="bg-gray-100 p-2 rounded-full relative cursor-pointer">
            <Bell size={20} className="text-gray-700"/>
            <span className="absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
          </div>
        </div>
      </div>
      
      <div className="max-w-6xl mx-auto flex flex-col lg:flex-row gap-6 p-0 md:p-6">
        <div className="flex-1 max-w-2xl mx-auto w-full">
          {/* Stories */}
          <div className="bg-white py-4 mb-4 shadow-sm md:rounded-2xl border border-gray-100">
            <div className="flex overflow-x-auto gap-3 px-4 scrollbar-hide pb-2">
              {stories.map(story => (
                <div key={story.id} className="relative w-24 h-36 md:w-28 md:h-44 flex-shrink-0 rounded-xl overflow-hidden shadow-sm border border-gray-100 cursor-pointer hover:scale-105 transition-transform">
                  {story.isAdd ? (
                    <div className="w-full h-full bg-gray-50 flex flex-col items-center justify-center group">
                      <img src={story.avatar} className="w-full h-24 md:h-28 object-cover absolute top-0" alt="user" />
                      <div className="absolute bottom-2 md:bottom-3 flex flex-col items-center w-full">
                        <div className="bg-[#0068FF] rounded-full p-1.5 border-2 border-white -mt-6 mb-1 shadow-md group-hover:bg-blue-600"><Plus size={16} className="text-white" /></div>
                        <span className="text-[10px] md:text-xs font-bold text-gray-800">Tạo tin 24h</span>
                      </div>
                    </div>
                  ) : (
                    <>
                      <img src={story.image} className="w-full h-full object-cover" alt="story" />
                      <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                      <div className="absolute top-2 left-2 p-0.5 bg-white rounded-full">
                        <img src={story.avatar} className={`w-8 h-8 rounded-full border-2 ${story.isBot ? 'border-purple-500' : 'border-[#0068FF]'}`} alt="avatar" />
                        {story.isBot && <span className="absolute -bottom-1 -right-1 bg-purple-500 text-white text-[8px] font-bold px-1 rounded border border-white">OA</span>}
                      </div>
                      <span className="absolute bottom-2 left-2 text-white text-[11px] md:text-xs font-bold leading-tight drop-shadow-md">{story.name}</span>
                    </>
                  )}
                </div>
              ))}
            </div>
          </div>

          <div className="bg-white p-4 mb-4 shadow-sm md:rounded-2xl border border-gray-100 flex items-center gap-3 cursor-pointer hover:bg-gray-50">
            <img src={currentUser.avatar} className="w-10 h-10 rounded-full bg-gray-100 border border-gray-200" alt="avatar" />
            <div className="bg-gray-100 flex-1 rounded-full py-2.5 md:py-3 px-4 text-gray-500 text-sm font-medium hover:bg-gray-200">Bạn đang cần tìm hoặc bán gì?</div>
          </div>

          <div className="flex gap-2 overflow-x-auto scrollbar-hide mb-4 px-4 md:px-0">
            <button onClick={() => setFeedFilter('all')} className={`whitespace-nowrap px-5 py-2 rounded-full text-xs md:text-sm font-bold border transition-colors ${feedFilter === 'all' ? 'bg-gray-800 text-white border-gray-800 shadow-md' : 'bg-white text-gray-600 shadow-sm border-gray-200 hover:bg-gray-50'}`}>Tất cả bảng tin</button>
            <button onClick={() => setFeedFilter('sell')} className={`whitespace-nowrap px-5 py-2 rounded-full text-xs md:text-sm font-bold border transition-colors ${feedFilter === 'sell' ? 'bg-[#0068FF] text-white border-[#0068FF] shadow-md' : 'bg-white text-[#0068FF] shadow-sm border-blue-200 hover:bg-blue-50'}`}>🏠 Tin Có</button>
            <button onClick={() => setFeedFilter('buy')} className={`whitespace-nowrap px-5 py-2 rounded-full text-xs md:text-sm font-bold border transition-colors ${feedFilter === 'buy' ? 'bg-red-500 text-white border-red-500 shadow-md' : 'bg-white text-red-500 shadow-sm border-red-200 hover:bg-red-50'}`}>🔎 Tin Cần</button>
          </div>

          <div className="animate-in fade-in duration-300">
            {filteredPosts.map(post => (
              <div key={post.id} className="bg-white p-4 md:p-5 mb-4 shadow-sm md:rounded-2xl border border-gray-100">
                <div className="flex justify-between items-start mb-3">
                  <div className="flex gap-3">
                    <div className="relative shrink-0">
                      <img src={post.author.avatar} className="w-10 h-10 md:w-12 md:h-12 rounded-full bg-gray-100 border border-gray-200" alt="avatar" />
                      {post.author.score === 'AI' ? <Zap size={14} className="absolute bottom-0 right-0 text-amber-500 bg-white rounded-full p-0.5" /> : <ShieldCheck size={14} className="absolute bottom-0 right-0 text-blue-500 bg-white rounded-full" />}
                    </div>
                    <div>
                      <div className="font-bold text-sm md:text-base flex items-center gap-1 text-gray-900">{post.author.name} <span className={`text-[10px] px-1.5 py-0.5 rounded font-bold ${post.author.score === 'AI' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-[#0068FF]'}`}>{post.author.score}</span></div>
                      <div className="text-[11px] md:text-xs text-gray-500 flex items-center gap-1 mt-0.5"><Clock size={12}/> {post.time} • <MapPin size={12}/> {post.location}</div>
                    </div>
                  </div>
                  <MoreHorizontal size={20} className="text-gray-400 cursor-pointer" />
                </div>
                <div className="mb-2"><span className={`text-[10px] md:text-xs font-bold px-2.5 py-1 rounded-md inline-block ${post.type === 'buy' ? 'bg-red-100 text-red-600' : post.type === 'sell' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700'}`}>{post.tag}</span></div>
                <p className="text-sm md:text-base text-gray-800 mb-4 leading-relaxed whitespace-pre-line">{post.content}</p>
                {post.botReply && (
                  <div className="bg-gray-50 border border-gray-200 rounded-xl p-3 md:p-4 flex gap-3 shadow-inner">
                    <div className="shrink-0 pt-1">{post.botReply.icon}</div>
                    <div>
                      <div className="font-bold text-[11px] md:text-xs text-gray-900 mb-1 flex items-center gap-1">🤖 {post.botReply.bot} <span className="bg-gray-200 text-gray-600 text-[8px] md:text-[9px] px-1 rounded uppercase tracking-wider">AI Phân tích</span></div>
                      <p className="text-xs md:text-sm text-gray-600 leading-relaxed">{post.botReply.text}</p>
                    </div>
                  </div>
                )}
                <div className="flex border-t border-gray-100 mt-4 pt-3 text-gray-500 text-sm font-medium">
                  <button className="flex-1 flex justify-center items-center gap-2 hover:text-[#0068FF]"><span className="text-lg">👍</span> Thích</button>
                  <button className="flex-1 flex justify-center items-center gap-2 hover:text-[#0068FF]"><MessageCircle size={18} /> Bình luận</button>
                </div>
              </div>
            ))}
            {filteredPosts.length === 0 && (
              <div className="bg-white p-8 md:rounded-2xl border border-gray-100 text-center flex flex-col items-center justify-center">
                <Search size={40} className="text-gray-300 mb-3" />
                <h3 className="text-gray-500 font-bold">Chưa có tin đăng nào phù hợp</h3>
              </div>
            )}
          </div>
        </div>

        {/* Sidebar Desktop Only */}
        <div className="hidden lg:block w-[320px] shrink-0">
           <div className="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 sticky top-6">
              <h3 className="font-black text-gray-900 mb-5 flex items-center gap-2"><Zap size={18} className="text-amber-500"/> Gợi ý AI (NHA.AI)</h3>
              <div className="space-y-4">
                 {officialAccounts.slice(0,3).map((oa) => (
                   <div key={oa.id} className="flex items-center gap-3 cursor-pointer group">
                     <div className={`w-12 h-12 rounded-xl ${oa.color} flex items-center justify-center shadow-sm group-hover:scale-105 transition`}><img src={`https://api.dicebear.com/7.x/bottts/svg?seed=${oa.name}`} className="w-7 h-7" alt="bot" /></div>
                     <div className="flex-1">
                       <h4 className="font-bold text-sm text-gray-900 group-hover:text-[#0068FF]">{oa.name}</h4>
                       <p className="text-[11px] text-gray-500">{oa.role}</p>
                     </div>
                     <button className="bg-blue-50 text-[#0068FF] px-3 py-1.5 rounded-lg text-xs font-bold hover:bg-blue-100">Chat</button>
                   </div>
                 ))}
              </div>
              <div className="mt-8 pt-5 border-t border-gray-100">
                 <h3 className="font-bold text-gray-900 mb-4 text-sm flex items-center gap-2"><TrendingUp size={16} className="text-green-500"/> Deal Hot Khớp Nhu Cầu</h3>
                 <div className="space-y-3">
                   <div className="bg-gray-50 p-3 rounded-xl border border-gray-100 cursor-pointer hover:border-blue-300 transition group">
                     <div className="flex justify-between mb-1"><span className="text-xs font-bold text-gray-900 group-hover:text-[#0068FF]">Sunrise City 2PN</span><span className="text-[10px] bg-green-100 text-green-700 px-1.5 py-0.5 rounded font-bold">Match 95%</span></div>
                     <p className="text-[11px] text-gray-500">3.5 Tỷ • Cách bạn 1.5km</p>
                   </div>
                 </div>
              </div>
           </div>
        </div>
      </div>
    </div>
  );
};

// ==========================================
// 3. TAB 2: BẢN ĐỒ & RADAR
// ==========================================
const MapAndRadarTab = () => {
  const [viewMode, setViewMode] = useState('map'); 
  const [selectedPin, setSelectedPin] = useState(null);

  return (
    <div className="h-full relative bg-[#AADAFF] overflow-hidden flex flex-col text-gray-800">
      <div className="absolute top-0 w-full z-20 bg-gradient-to-b from-white via-white/80 to-transparent pt-4 md:pt-6 pb-8 px-4 md:px-8 pointer-events-none">
        <div className="max-w-3xl mx-auto flex flex-col gap-3 pointer-events-auto">
          <div className="flex bg-gray-100/90 backdrop-blur-md p-1.5 rounded-2xl shadow-sm mb-1 mx-auto w-full md:w-fit border border-gray-200">
            <button onClick={() => setViewMode('map')} className={`flex-1 md:w-40 flex justify-center items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-sm transition-all duration-300 ${viewMode === 'map' ? 'bg-white text-[#0068FF] shadow-sm' : 'text-gray-500 hover:text-gray-700'}`}><MapIcon size={18}/> Bản đồ thực</button>
            <button onClick={() => setViewMode('radar')} className={`flex-1 md:w-40 flex justify-center items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-sm transition-all duration-300 ${viewMode === 'radar' ? 'bg-[#0068FF] text-white shadow-md' : 'text-gray-500 hover:text-gray-700'}`}><Radar size={18} className={viewMode === 'radar' ? 'animate-[spin_4s_linear_infinite]' : ''}/> Quét Radar</button>
          </div>
          <div className="flex gap-2">
            <div className="bg-white rounded-xl shadow-lg border border-gray-100 flex items-center px-4 py-3 flex-1">
              <Search size={20} className="text-gray-400 mr-2" />
              <input type="text" placeholder="Tìm kiếm theo khu vực, đường..." className="flex-1 outline-none text-sm font-medium bg-transparent"/>
              <div className="border-l pl-3 ml-2 cursor-pointer"><Filter size={18} className="text-[#0068FF]" /></div>
            </div>
          </div>
        </div>
      </div>

      <div className="flex-1 relative">
        {viewMode === 'map' && (
          <div className="absolute inset-0 z-0 animate-in fade-in duration-300 bg-[#AADAFF]">
            <img src="https://images.unsplash.com/photo-1524661135-423995f22d0b?w=1600&q=80" className="w-full h-full object-cover opacity-50 mix-blend-multiply pointer-events-none" alt="Map Background"/>
            <div className="absolute top-[50%] left-[50%] transform -translate-x-1/2 -translate-y-1/2 z-10">
              <div className="w-16 h-16 bg-[#0068FF]/20 rounded-full animate-ping absolute -inset-4"></div>
              <div className="w-8 h-8 bg-white rounded-full border-2 border-[#0068FF] p-0.5 shadow-xl relative z-10"><img src={currentUser.avatar} className="w-full h-full rounded-full bg-gray-100" alt="me" /></div>
            </div>
            {mapPins.map(pin => (
              <div key={pin.id} className="absolute transform -translate-x-1/2 -translate-y-full cursor-pointer z-10 hover:z-20 transition-transform hover:scale-110" style={{ top: pin.lat, left: pin.lng }} onClick={() => setSelectedPin(pin)}>
                <div className={`${selectedPin?.id === pin.id ? 'bg-[#1A1A1A] ring-4 ring-[#1A1A1A]/30 scale-110 shadow-2xl' : 'bg-[#1A1A1A] shadow-lg'} text-white text-xs font-bold px-3 py-1.5 rounded-full relative flex items-center justify-center min-w-[50px] transition-all`}>
                  {pin.price}
                  <div className="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-2.5 h-2.5 bg-[#1A1A1A] rotate-45 rounded-sm"></div>
                </div>
              </div>
            ))}
          </div>
        )}
        {viewMode === 'radar' && (
          <div className="absolute inset-0 z-0 bg-[#0B132B] flex items-center justify-center animate-in fade-in duration-300">
            <div className="relative w-[320px] h-[320px] md:w-[600px] md:h-[600px] flex items-center justify-center rounded-full overflow-hidden">
              <div className="absolute w-[100%] h-[100%] border border-cyan-500/20 rounded-full"></div>
              <div className="absolute w-[66%] h-[66%] border border-cyan-500/30 rounded-full"></div>
              <div className="absolute w-[33%] h-[33%] border border-cyan-500/40 rounded-full"></div>
              <div className="absolute w-1/2 h-1/2 top-0 right-0 origin-bottom-left border-r-2 border-cyan-400 bg-gradient-to-tr from-cyan-500/40 to-transparent animate-[spin_3s_linear_infinite] rounded-tr-full"></div>
              <div className="relative z-10 w-12 h-12 bg-white rounded-full border-2 border-cyan-400 p-0.5 shadow-[0_0_30px_rgba(6,182,212,0.8)]"><img src={currentUser.avatar} className="w-full h-full rounded-full" alt="me" /></div>
              {mapPins.map((pin, idx) => (
                <div key={pin.id} className="absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 hover:scale-110 hover:z-20 transition-transform" style={{ top: pin.lat, left: pin.lng }} onClick={() => setSelectedPin(pin)}>
                  <div className={`w-3 h-3 rounded-full shadow-[0_0_15px_rgba(0,0,0,0.8)] border border-white animate-pulse ${pin.type === 'sell' ? 'bg-cyan-400' : 'bg-red-400'}`} style={{ animationDelay: `${idx * 0.5}s` }}></div>
                </div>
              ))}
            </div>
            <div className="absolute bottom-12 flex flex-col items-center"><span className="text-cyan-400 text-xs md:text-sm tracking-widest uppercase font-bold animate-pulse">Đang quét bán kính 3km...</span></div>
          </div>
        )}
      </div>

      <div className={`absolute z-30 transition-all duration-300 ease-in-out bg-white bottom-0 left-0 w-full rounded-t-3xl shadow-[0_-20px_40px_rgba(0,0,0,0.15)] pb-24 md:pb-6 md:bottom-auto md:top-28 md:right-8 md:w-[400px] md:rounded-2xl ${selectedPin ? 'translate-y-0 md:translate-x-0 opacity-100' : 'translate-y-full md:translate-y-0 md:translate-x-[120%] opacity-0 pointer-events-none'}`}>
        {selectedPin && (
          <div className="p-5">
            <div className="w-12 h-1.5 bg-gray-200 rounded-full mx-auto mb-4 cursor-pointer md:hidden" onClick={() => setSelectedPin(null)}></div>
            <h3 className="font-bold text-lg leading-tight mb-2">{selectedPin.title}</h3>
            <div className="flex items-center justify-between mb-4 border-b border-gray-100 pb-4">
              <span className={`font-black text-2xl ${selectedPin.type === 'sell' ? 'text-[#0068FF]' : 'text-red-500'}`}>{selectedPin.price}</span>
              <span className="flex items-center gap-1 bg-green-50 text-green-600 px-2 py-1 rounded-lg text-xs font-bold"><Zap size={14}/> Match {selectedPin.match}</span>
            </div>
            <div className="flex items-center justify-between bg-gray-50 p-3 rounded-xl mb-4 border border-gray-100">
              <div className="flex items-center gap-3">
                <img src={selectedPin.avatar} className="w-10 h-10 rounded-full border-2 border-white shadow-sm" alt="avatar" />
                <div>
                  <div className="font-bold text-sm">{selectedPin.author} <ShieldCheck size={14} className="text-blue-500 inline"/></div>
                  <div className="text-xs text-gray-500 mt-0.5">Cách bạn {selectedPin.distance}</div>
                </div>
              </div>
            </div>
            <div className="flex gap-2">
              <button className="flex-1 bg-gray-100 text-gray-700 font-bold py-3 rounded-xl flex justify-center items-center gap-2"><Navigation size={16}/> Chỉ đường</button>
              <button className={`flex-1 text-white font-bold py-3 rounded-xl flex justify-center items-center gap-2 shadow-lg ${selectedPin.type === 'sell' ? 'bg-[#0068FF]' : 'bg-red-500'}`}><MessageCircle size={16}/> Chat ngay</button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

// ==========================================
// 4. TAB 3: KHỚP NHANH (TINDER SWIPE)
// ==========================================
const SwipeMatchTab = ({ setActiveTab }) => {
  const [cards, setCards] = useState(swipeCards);
  const [animatingId, setAnimatingId] = useState(null);
  const [animationClass, setAnimationClass] = useState('');
  const [showMatchOverlay, setShowMatchOverlay] = useState(false);
  const [matchedCard, setMatchedCard] = useState(null);

  const handleAction = (action, card) => {
    if (cards.length === 0 || showMatchOverlay) return;
    setAnimatingId(card.id);
    if (action === 'pass') setAnimationClass('translate-x-[-150%] rotate-[-20deg] opacity-0');
    if (action === 'ai') setAnimationClass('translate-y-[-150%] opacity-0');
    if (action === 'like') setAnimationClass('translate-x-[150%] rotate-[20deg] opacity-0');

    setTimeout(() => {
      if (action === 'like') { setMatchedCard(card); setShowMatchOverlay(true); } 
      else { setCards(prev => prev.filter(c => c.id !== card.id)); }
      setAnimatingId(null); setAnimationClass('');
    }, 400); 
  };

  if (showMatchOverlay && matchedCard) {
    return (
      <div className="absolute inset-0 z-50 bg-[#0B132B] flex flex-col items-center justify-center p-6 animate-in fade-in duration-300">
        <div className="absolute inset-0 bg-gradient-to-t from-[#0068FF]/50 to-transparent"></div>
        <div className="relative z-10 flex flex-col items-center">
          <h1 className="text-5xl md:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-cyan-400 mb-2 italic transform -skew-x-12 drop-shadow-lg">MATCH!</h1>
          <p className="text-white text-lg mb-10">Bạn và <span className="font-bold text-amber-400">{matchedCard.author}</span> đã khớp nhu cầu.</p>
          <div className="flex gap-4 items-center mb-12">
            <img src={currentUser.avatar} className="w-24 h-24 rounded-full border-4 border-[#0068FF] shadow-[0_0_30px_rgba(0,104,255,0.6)]" alt="user" />
            <div className="w-12 h-12 rounded-full bg-white flex items-center justify-center z-10 -mx-6"><Heart size={24} className="text-red-500 fill-red-500 animate-pulse" /></div>
            <img src={matchedCard.authorAvatar} className="w-24 h-24 rounded-full border-4 border-green-400 shadow-[0_0_30px_rgba(74,222,128,0.6)]" alt="matched user" />
          </div>
          <button onClick={() => {setShowMatchOverlay(false); setActiveTab('chat');}} className="bg-gradient-to-r from-[#0068FF] to-cyan-500 text-white font-bold text-lg w-full max-w-xs py-4 rounded-full shadow-[0_10px_30px_rgba(0,104,255,0.5)] hover:scale-105 transition flex items-center justify-center gap-2">
            <MessageCircle size={24}/> Vào phòng đàm phán
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="h-full bg-[#111] overflow-hidden flex flex-col relative pb-20 md:pb-0">
      <div className="pt-6 pb-4 px-6 flex justify-between items-center z-10 absolute w-full top-0 bg-gradient-to-b from-black/70 to-transparent pointer-events-none">
        <h1 className="text-xl font-black text-white flex items-center gap-2"><Flame className="text-amber-500 fill-amber-500"/> Khớp Nhanh</h1>
        <div className="bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-white text-xs font-bold border border-white/30 pointer-events-auto cursor-pointer"><Filter size={12} className="inline mr-1"/> Lọc</div>
      </div>

      <div className="flex-1 relative flex justify-center items-center p-4 pt-16">
        {cards.length === 0 ? (
          <div className="text-center text-gray-500"><div className="w-20 h-20 bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-4"><Flame size={40} className="text-gray-600"/></div><p className="font-bold text-lg">Đã hết gợi ý hôm nay.</p></div>
        ) : (
          <div className="relative w-full max-w-sm h-[65vh] md:h-[75vh]">
            {[...cards].reverse().map((card, index) => {
              const isTop = index === cards.length - 1;
              const isAnimating = animatingId === card.id;
              return (
                <div key={card.id} className={`absolute inset-0 rounded-3xl overflow-hidden shadow-2xl transition-all duration-300 ease-out origin-bottom ${isTop ? 'z-20 scale-100' : 'z-10 scale-95 -translate-y-4 opacity-80'} ${isAnimating ? animationClass : ''}`}>
                  <img src={card.image} className="w-full h-full object-cover" alt="card image" />
                  <div className="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/90 flex flex-col justify-end p-6">
                    <div className="flex justify-between items-end mb-2">
                      <span className="bg-green-500 text-white font-bold text-xs px-3 py-1.5 rounded-full flex items-center gap-1 shadow-lg backdrop-blur-md"><Zap size={14}/> Match {card.match}</span>
                      <div className="flex flex-col items-center"><img src={card.authorAvatar} className="w-12 h-12 rounded-full border-2 border-white shadow-md mb-1" alt="avatar" /><span className="text-white text-[10px] font-bold bg-black/50 px-2 py-0.5 rounded">{card.author}</span></div>
                    </div>
                    <h2 className="text-4xl font-black text-white drop-shadow-md mb-1">{card.price}</h2>
                    <h3 className="text-lg font-medium text-gray-200 drop-shadow-md mb-3 leading-tight">{card.title}</h3>
                    <div className="flex gap-2 mb-4 flex-wrap">{card.tags.map(tag => (<span key={tag} className="bg-white/20 backdrop-blur-md text-white text-xs px-2.5 py-1 rounded-md border border-white/30">{tag}</span>))}</div>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      {cards.length > 0 && (
        <div className="flex justify-center items-center gap-6 pb-8 md:pb-12 z-20">
          <button onClick={() => handleAction('pass', cards[0])} className="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-xl hover:scale-110 transition-transform group border border-gray-200"><X size={32} className="text-red-500 group-hover:scale-110" /></button>
          <button onClick={() => handleAction('ai', cards[0])} className="w-14 h-14 bg-white rounded-full flex items-center justify-center shadow-xl hover:scale-110 transition-transform group border border-gray-200"><Star size={26} className="text-[#0068FF] fill-[#0068FF] group-hover:scale-110" /></button>
          <button onClick={() => handleAction('like', cards[0])} className="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-xl hover:scale-110 transition-transform group border border-gray-200"><Heart size={32} className="text-green-500 fill-green-500 group-hover:scale-110" /></button>
        </div>
      )}
    </div>
  );
};

// ==========================================
// 5. TAB 4: TIN NHẮN & OA
// ==========================================
const ChatAndOA = () => (
  <div className="h-full bg-white flex flex-col md:flex-row overflow-hidden pb-24 md:pb-0 border-t border-gray-200">
    <div className="w-full md:w-[350px] lg:w-[400px] flex flex-col h-full border-r border-gray-200 bg-white z-10">
      <div className="px-4 py-4 md:py-5 border-b flex justify-between items-center bg-[#0068FF] md:bg-white md:text-gray-900 text-white shrink-0 shadow-sm">
