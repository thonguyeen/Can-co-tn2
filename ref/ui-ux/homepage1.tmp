  </div>
);

// ==========================================
// 7. CHATBOT GLOBAL COMPONENT
// ==========================================
const GlobalChatbot = () => {
  const [isOpen, setIsOpen] = useState(false);
  const [messages, setMessages] = useState([{ id: 1, sender: 'bot', text: 'Xin chào! Tôi là Trợ lý AI. Tôi có thể giúp bạn định giá nhà, tìm kiếm nguồn cung hoặc giải đáp pháp lý ngay bây giờ.' }]);
  const [inputValue, setInputValue] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const messagesEndRef = useRef(null);

  useEffect(() => { messagesEndRef.current?.scrollIntoView({ behavior: "smooth" }); }, [messages, isTyping, isOpen]);

  const handleSend = () => {
    if (!inputValue.trim()) return;
    setMessages(prev => [...prev, { id: Date.now(), sender: 'user', text: inputValue }]);
    setInputValue('');
    setIsTyping(true);
    setTimeout(() => {
      setIsTyping(false);
      setMessages(prev => [...prev, { id: Date.now() + 1, sender: 'bot', text: 'Yêu cầu đang được hệ thống phân tích...' }]);
    }, 1500);
  };

  return (
    <>
      <button onClick={() => setIsOpen(true)} className={`fixed z-[60] bottom-24 right-4 md:bottom-8 md:right-8 bg-gradient-to-r from-[#0068FF] to-indigo-600 text-white p-4 rounded-full shadow-[0_8px_30px_rgba(0,104,255,0.4)] hover:scale-110 transition-transform duration-300 flex items-center justify-center group ${isOpen ? 'scale-0 opacity-0' : 'scale-100 opacity-100'}`}>
        <Bot size={28} className="relative z-10" />
        <span className="absolute top-0 right-0 w-3 h-3 bg-red-500 border-2 border-white rounded-full"></span>
      </button>

      <div className={`fixed z-[70] transition-all duration-300 ease-in-out shadow-2xl flex flex-col bg-white overflow-hidden ${isOpen ? 'translate-y-0 opacity-100' : 'translate-y-[120%] opacity-0 pointer-events-none'} bottom-0 left-0 w-full h-[80vh] rounded-t-3xl md:bottom-8 md:right-8 md:w-[380px] md:h-[600px] md:rounded-2xl border border-gray-200`}>
        <div className="bg-gradient-to-r from-[#0068FF] to-indigo-600 p-4 flex justify-between items-center text-white shrink-0">
           <div className="flex items-center gap-3">
             <div className="bg-white/20 p-2 rounded-xl"><Bot size={24} className="text-white"/></div>
             <div><h3 className="font-bold text-base flex items-center gap-1">NHA.AI Assistant</h3></div>
           </div>
           <button onClick={() => setIsOpen(false)} className="bg-white/10 hover:bg-white/20 p-1.5 rounded-full"><Minimize2 size={20}/></button>
        </div>
        <div className="flex-1 overflow-y-auto p-4 bg-gray-50 flex flex-col gap-4">
           {messages.map(msg => (
             <div key={msg.id} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                {msg.sender === 'bot' && <div className="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white shrink-0 mr-2 mt-1"><Bot size={16}/></div>}
                <div className={`max-w-[80%] p-3 rounded-2xl text-sm shadow-sm ${msg.sender === 'user' ? 'bg-[#0068FF] text-white rounded-tr-sm' : 'bg-white text-gray-800 rounded-tl-sm border border-gray-100'}`}>{msg.text}</div>
             </div>
           ))}
           {isTyping && (
             <div className="flex justify-start">
                <div className="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white shrink-0 mr-2 mt-1"><Bot size={16}/></div>
                <div className="bg-white p-4 rounded-2xl rounded-tl-sm shadow-sm flex gap-1 items-center">
                   <div className="w-2 h-2 bg-gray-300 rounded-full animate-bounce"></div><div className="w-2 h-2 bg-gray-300 rounded-full animate-bounce" style={{ animationDelay: '0.2s' }}></div><div className="w-2 h-2 bg-gray-300 rounded-full animate-bounce" style={{ animationDelay: '0.4s' }}></div>
                </div>
             </div>
           )}
           <div ref={messagesEndRef} />
        </div>
        <div className="bg-white border-t border-gray-100 p-3 shrink-0">
          <div className="flex items-center gap-2 bg-gray-100 rounded-full p-1.5 border border-gray-200">
             <input type="text" placeholder="Nhập câu hỏi..." className="flex-1 bg-transparent outline-none px-3 text-sm text-gray-800" value={inputValue} onChange={(e) => setInputValue(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && handleSend()} />
             <button onClick={handleSend} className={`p-2 rounded-full transition-colors ${inputValue.trim() ? 'bg-[#0068FF] text-white shadow-md' : 'bg-gray-200 text-gray-400'}`}><Send size={16} /></button>
          </div>
        </div>
      </div>
    </>
  );
};

// ==========================================
// 8. MAIN APP COMPONENT & NAVIGATION
// ==========================================
export default function App() {
  const [activeTab, setActiveTab] = useState('swipe'); // Default to Swipe feature

  const DesktopNavItem = ({ icon, label, id, badge }) => (
    <button onClick={() => setActiveTab(id)} className={`flex items-center justify-center lg:justify-start gap-4 px-3 py-3 lg:px-4 lg:py-3.5 rounded-xl transition-all ${activeTab === id ? 'bg-blue-50 text-[#0068FF] font-bold shadow-sm' : 'text-gray-600 hover:bg-gray-100 font-medium'}`}>
      <div className="relative shrink-0">{icon}{badge && <span className="absolute -top-1.5 -right-2 bg-red-500 text-white text-[10px] font-bold w-4 h-4 flex items-center justify-center rounded-full border-2 border-white shadow-sm">{badge}</span>}</div>
      <span className="hidden lg:block text-[15px]">{label}</span>
    </button>
  );

  const MobileNavItem = ({ icon, label, id, badge }) => (
    <button onClick={() => setActiveTab(id)} className={`flex flex-col items-center gap-1 w-1/5 relative transition-colors ${activeTab === id ? 'text-[#0068FF]' : 'text-gray-400 hover:text-gray-600'}`}>
      <div className="relative">{icon}{badge && <span className="absolute -top-1.5 -right-2 bg-red-500 text-white text-[10px] font-bold w-4 h-4 flex items-center justify-center rounded-full border-2 border-white shadow-sm">{badge}</span>}</div>
      <span className={`text-[10px] ${activeTab === id ? 'font-bold' : 'font-medium'} truncate w-full text-center`}>{label}</span>
    </button>
  );

  return (
    <div className="w-full h-screen flex bg-gray-50 overflow-hidden font-sans text-gray-900">
      
      {/* DESKTOP SIDEBAR */}
      <div className="hidden md:flex w-24 lg:w-64 flex-col bg-white border-r border-gray-200 shadow-sm z-50">
        <div className="h-20 flex items-center justify-center lg:justify-start lg:px-6 border-b border-gray-100">
          <h1 className="text-2xl font-black text-[#0068FF] hidden lg:block tracking-tighter">Cần<span className="text-green-500">&</span>Có</h1>
          <div className="lg:hidden w-10 h-10 bg-[#0068FF] rounded-xl flex items-center justify-center text-white font-black">C&C</div>
        </div>
        <div className="flex-1 py-6 flex flex-col gap-2 px-3">
          <DesktopNavItem icon={<Home size={22}/>} label="Trang chủ" id="home" />
          <DesktopNavItem icon={<MapIcon size={22}/>} label="Bản đồ" id="map" />
          <DesktopNavItem icon={<Flame size={22}/>} label="Khớp Nhanh" id="swipe" />
          <DesktopNavItem icon={<MessageCircle size={22}/>} label="Tin nhắn" id="chat" badge={3} />
          <DesktopNavItem icon={<LayoutGrid size={22}/>} label="Tiện ích" id="apps" />
        </div>
      </div>

      {/* MAIN CONTENT AREA */}
      <main className="flex-1 relative flex flex-col min-w-0 overflow-hidden">
        
        {/* Render Active Tab */}
        {activeTab === 'home' && <FeedTab />}
        {activeTab === 'map' && <MapAndRadarTab />}
        {activeTab === 'swipe' && <SwipeMatchTab setActiveTab={setActiveTab} />}
        {activeTab === 'chat' && <ChatAndOA />}
        {activeTab === 'apps' && <MiniAppsHub />}
        
        {/* MOBILE BOTTOM NAV */}
        <div className="md:hidden absolute bottom-0 w-full bg-white/95 backdrop-blur-md border-t border-gray-200 px-2 py-2 pb-6 flex justify-between items-center z-40 shadow-[0_-5px_20px_rgba(0,0,0,0.05)]">
          <MobileNavItem icon={<Home size={24}/>} label="Trang chủ" id="home" />
          <MobileNavItem icon={<MapIcon size={24}/>} label="Bản đồ" id="map" />
          <MobileNavItem icon={<Flame size={24} className={activeTab === 'swipe' ? 'text-amber-500 fill-amber-500 drop-shadow-md' : ''}/>} label="Khớp Nhanh" id="swipe" />
          <MobileNavItem icon={<MessageCircle size={24}/>} label="Tin nhắn" id="chat" badge={3} />
          <MobileNavItem icon={<LayoutGrid size={24}/>} label="Tiện ích" id="apps" />
        </div>
      </main>

      {/* CHATBOT GLOBAL */}
      <GlobalChatbot />
    </div>
  );
}