  <div className="flex flex-col items-center gap-3 cursor-pointer group">
    <div className={`w-16 h-16 md:w-20 md:h-20 rounded-3xl flex items-center justify-center ${color} shadow-sm group-hover:-translate-y-2 transition-transform group-hover:shadow-md`}>
      {icon}
    </div>
    <span className="text-[11px] md:text-sm font-bold text-gray-700 text-center">{label}</span>
  </div>
);

const MiniAppsHub = () => (
  <div className="bg-gray-100 min-h-full pb-24 md:pb-6 overflow-y-auto">
    <div className="md:hidden bg-white px-4 py-4 sticky top-0 z-20 border-b border-gray-100 shadow-sm">
      <h1 className="text-xl font-bold text-gray-900">Khám Phá Tiện Ích</h1>
    </div>
    <div className="max-w-6xl mx-auto flex flex-col lg:flex-row gap-6 p-0 md:p-6">
