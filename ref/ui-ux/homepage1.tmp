          <MiniAppIcon icon={<ShieldCheck size={28}/>} color="bg-amber-100 text-amber-600" label="Tra Cứu" />
          <MiniAppIcon icon={<Award size={28}/>} color="bg-rose-100 text-rose-600" label="Xếp Hạng" />
          <MiniAppIcon icon={<Users size={28}/>} color="bg-cyan-100 text-cyan-600" label="Tìm Môi Giới" />
          <MiniAppIcon icon={<Video size={28}/>} color="bg-indigo-100 text-indigo-600" label="Tour VR" />
          <MiniAppIcon icon={<MoreHorizontal size={28}/>} color="bg-gray-100 text-gray-600" label="Tất cả" />
        </div>
      </div>
      <div className="w-full lg:w-[350px] bg-white p-6 md:p-8 md:rounded-3xl shadow-sm border border-gray-100 h-fit">
        <h2 className="text-base font-black text-gray-900 mb-6 uppercase tracking-wider flex items-center gap-2"><Zap className="text-amber-500"/> Dịch vụ liên kết</h2>
        <div className="space-y-4">
          <div className="flex items-center gap-4 border border-gray-100 p-4 rounded-2xl shadow-sm hover:shadow-md transition-shadow cursor-pointer bg-white group">
            <div className="w-12 h-12 bg-red-50 rounded-xl flex items-center justify-center text-red-600 font-black border border-red-100">MB</div>
            <div className="flex-1">
              <h3 className="font-bold text-sm text-gray-900 mb-1">Gói vay ưu đãi MB</h3>
              <p className="text-[11px] text-gray-500">Lãi suất 6.5%/năm</p>
            </div>
          </div>
        </div>
