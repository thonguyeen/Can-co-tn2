                {oa.unread > 0 && <span className="absolute -top-1.5 -right-1.5 bg-red-500 text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">{oa.unread}</span>}
              </div>
              <span className="text-[10px] font-bold mt-2 text-center leading-tight truncate w-full text-gray-700">{oa.name}</span>
            </div>
          ))}
        </div>
      </div>

      <div className="flex-1 overflow-y-auto bg-white">
        <div className="flex items-center gap-3 p-4 border-b hover:bg-gray-50 cursor-pointer bg-blue-50/50">
          <div className="relative w-14 h-14 flex flex-wrap rounded-full overflow-hidden border-2 border-white shadow-sm shrink-0">
            <img src={currentUser.avatar} className="w-1/2 h-1/2 object-cover bg-blue-100" alt="user" />
            <img src="https://api.dicebear.com/7.x/bottts/svg?seed=Orch" className="w-1/2 h-1/2 object-cover bg-purple-100" alt="bot" />
          </div>
          <div className="flex-1 overflow-hidden">
            <div className="flex justify-between items-center mb-1">
              <h3 className="font-bold text-[15px] text-gray-900 truncate">Phòng đàm phán <ShieldCheck size={14} className="text-green-500 inline"/></h3>
              <span className="text-[10px] font-bold bg-red-500 text-white px-1.5 py-0.5 rounded-full">Mới</span>
            </div>
            <p className="text-sm text-gray-800 truncate"><span className="text-[#0068FF]">Orchestrator Bot:</span> Hợp đồng đã sẵn sàng.</p>
          </div>
        </div>
        <div className="flex items-center gap-3 p-4 border-b hover:bg-gray-50 cursor-pointer">
          <div className="relative w-14 h-14 shrink-0">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=User2" className="w-14 h-14 rounded-full bg-gray-100 border border-gray-200" alt="user" />
            <div className="absolute bottom-0 right-0 w-3.5 h-3.5 bg-green-500 rounded-full border-2 border-white"></div>
          </div>
          <div className="flex-1 overflow-hidden">
            <div className="flex justify-between items-center mb-1">
              <h3 className="font-bold text-[15px] text-gray-900 truncate">Trần Văn Hùng</h3>
              <span className="text-xs text-gray-400">10:42</span>
            </div>
            <p className="text-sm text-gray-500 truncate">Dạ vâng, để em gửi thêm hình sổ đỏ qua cho anh.</p>
          </div>
        </div>
      </div>
    </div>
    
    <div className="hidden md:flex flex-1 flex-col bg-[#F3F4F6] relative">
      <div className="h-20 bg-white border-b border-gray-200 flex items-center justify-between px-6 shadow-sm z-10">
        <div className="flex items-center gap-4">
           <div className="w-12 h-12 flex flex-wrap rounded-full overflow-hidden border border-gray-200 shadow-sm shrink-0">
            <img src={currentUser.avatar} className="w-1/2 h-1/2 object-cover" alt="user1" />
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=User3" className="w-1/2 h-1/2 object-cover" alt="user2" />
            <img src="https://api.dicebear.com/7.x/bottts/svg?seed=Orch" className="w-full h-1/2 object-cover" alt="bot" />
          </div>
          <div>
            <h2 className="font-bold text-lg text-gray-900">Phòng khớp lệnh kín: Căn 2PN</h2>
            <p className="text-sm text-green-600 font-medium">1 Bot, 2 Người đang online</p>
          </div>
        </div>
      </div>
      <div className="flex-1 overflow-y-auto p-6 flex flex-col gap-6">
        <div className="flex justify-center"><span className="bg-gray-200 text-gray-500 text-xs px-3 py-1 rounded-full font-medium">Hôm nay 09:30</span></div>
        <div className="flex gap-4">
           <img src="https://api.dicebear.com/7.x/bottts/svg?seed=Orch" className="w-10 h-10 rounded-full bg-purple-100 border border-purple-200" alt="bot" />
           <div className="bg-white p-4 rounded-2xl rounded-tl-none border border-gray-200 shadow-sm max-w-xl">
             <div className="font-bold text-sm text-[#0068FF] mb-1">Agent Orchestrator <span className="text-[10px] bg-blue-100 px-1 rounded ml-1">AI</span></div>
             <p className="text-gray-800 leading-relaxed">Chào hai bạn. Mức chốt đề xuất <span className="font-bold text-green-600">3.55 tỷ</span>. Tôi đã tạo sẵn hợp đồng nháp.</p>
             <button className="mt-3 bg-[#0068FF] text-white px-4 py-2 rounded-lg text-sm font-bold flex items-center gap-2 hover:bg-blue-600 transition"><FileText size={16}/> Xem Hợp Đồng</button>
           </div>
        </div>
      </div>
      <div className="bg-white border-t border-gray-200 p-4">
        <div className="max-w-4xl mx-auto flex items-center gap-3 bg-gray-100 p-2 rounded-full border border-gray-200">
          <input type="text" placeholder="Nhập tin nhắn..." className="flex-1 bg-transparent outline-none text-gray-800 px-4" />
          <button className="bg-[#0068FF] text-white p-2.5 rounded-full shadow-md"><Send size={18} /></button>
