# ═══════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT - Can-co-tn
# ═══════════════════════════════════════════════════

# --- Database (Supabase) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cancotn"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cancotn"

# --- Auth ---
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="your-secret"

# --- AI Providers ---
# Anthropic (Optional - bỏ trống nếu không dùng)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Primary AI (Required)
AI_PRIMARY_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
AI_PRIMARY_BASE_URL="https://api.openai.com/v1"
AI_PRIMARY_MODEL="gpt-4o-mini"

# Fallback AI (Optional nhưng khuyến nghị)
AI_FALLBACK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
AI_FALLBACK_BASE_URL="https://api.openai.com/v1"
AI_FALLBACK_MODEL="gpt-4o-mini"

# Legacy (sẽ bị đọc nếu AI_PRIMARY không set)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Admin ---
ADMIN_EMAILS="admin@cancotn.com"

# --- Cron ---
CRON_SECRET="your-cron-secret"

# --- n8n Crawler Infrastructure (Phase 06b) ---
N8N_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
N8N_PASSWORD=REPLACE_WITH_STRONG_N8N_PASSWORD
N8N_WEBHOOK_CALLBACK_URL=https://your-domain.com
