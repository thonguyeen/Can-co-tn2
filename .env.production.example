# ════════════════════════════════════════════════════
# Cần & Có — Production Environment Template
# Copy sang .env.production rồi điền giá trị thật
#
# Tạo secrets mạnh:
#   POSTGRES_PASSWORD: openssl rand -hex 16
#   NEXTAUTH_SECRET:   openssl rand -hex 32
#   N8N_WEBHOOK_SECRET: openssl rand -hex 32
# ════════════════════════════════════════════════════

# ═══ DATABASE ════════════════════════════════════════
# Password cho PostgreSQL container
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Connection string — dùng tên container Docker (can-co_db)
DATABASE_URL=postgresql://cancotn:CHANGE_ME_STRONG_PASSWORD@can-co_db:5432/cancotn?schema=public

# ═══ AUTH ════════════════════════════════════════════
NEXTAUTH_URL=https://YOUR_DOMAIN.com
NEXTAUTH_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# ═══ ADMIN ACCESS ════════════════════════════════════
ADMIN_EMAILS=admin@yourdomain.com

# ═══ N8N WEBHOOK ═════════════════════════════════════
# Phải khớp với Authorization header trong n8n HTTP node
N8N_WEBHOOK_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# ═══ AI PROVIDERS ════════════════════════════════════
# Primary: 9router (kết nối nội bộ Docker nếu 9router_app cùng VPS)
# Internal:  http://9router_app:20128/v1
# External:  http://YOUR_VPS_IP:20128/v1
AI_PRIMARY_API_KEY=YOUR_9ROUTER_API_KEY
AI_PRIMARY_BASE_URL=http://9router_app:20128/v1
AI_PRIMARY_MODEL=cb1-chatbot-opencode

# Fallback: SimpleVerse (ổn định 100%)
AI_FALLBACK_API_KEY=YOUR_FALLBACK_API_KEY
AI_FALLBACK_BASE_URL=https://futrixapi.com/v1
AI_FALLBACK_MODEL=auto

# Legacy (cho các module cũ)
OPENAI_API_KEY=YOUR_9ROUTER_API_KEY
OPENAI_BASE_URL=http://9router_app:20128/v1
OPENAI_MODEL=cb1-chatbot-opencode

# ═══ MAP (OPTIONAL) ══════════════════════════════════
# Free tier: 500 req/day. Để trống thì dùng mock fallback.
NEXT_PUBLIC_ORS_API_KEY=
